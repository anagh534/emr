@baseUrl = http://localhost:5000/api

### 1. Register a Super Admin User
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "System Super Admin",
  "email": "admin@emr.com",
  "password": "adminpassword123",
  "role": "Super Admin"
}

### 2. Register a Doctor User
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Dr. Gregory House",
  "email": "doctor@emr.com",
  "password": "doctorpassword123",
  "role": "Doctor"
}

### 3. Register a Receptionist User
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Jane Doe",
  "email": "receptionist@emr.com",
  "password": "receptionistpassword123",
  "role": "Receptionist"
}

### 4. User Login (Retrieves access and refresh tokens)
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@emr.com",
  "password": "adminpassword123"
}

### Capture response tokens
@accessToken = {{login.response.body.data.accessToken}}
@refreshToken = {{login.response.body.data.refreshToken}}

### 5. Refresh Access Token (Generates a new access token)
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### 6. User Logout (Invalidates the refresh token)
POST {{baseUrl}}/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}
